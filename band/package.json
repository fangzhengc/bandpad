{
  "name": "bandpad",
  "version": "1.2.0",
  "description": "Mi Band 9 Pro page-flip remote for phone",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "node node_modules/aiot-toolkit/lib/bin.js start --watch --open-nuttx",
    "build": "node node_modules/aiot-toolkit/lib/bin.js build",
    "release": "node node_modules/aiot-toolkit/lib/bin.js release",
    "watch": "node node_modules/aiot-toolkit/lib/bin.js watch --open-nuttx"
  },
  "devDependencies": {
    "@aiot-toolkit/velasim": "^0.1.23",
    "aiot-toolkit": "^2.0.5"
  },
  "browserslist": [
    "chrome 65"
  ]
}
