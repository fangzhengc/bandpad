<template>
  <div class="page" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd" @touchcancel="onTouchCancel">
    <div class="topbar">
      <div class="status">
        <div class="dot" style="background-color: {{ linked ? '#1D9E75' : '#A32D2D' }}"></div>
        <text class="status-text">{{ linked ? '已连接' : '未连接' }}</text>
      </div>
      <text class="exit" @click="exit">退出</text>
    </div>

    <div class="stage">
      <text class="arrow">{{ arrow }}</text>
      <text class="action">{{ actionText }}</text>
    </div>

    <div class="pad" if="{{ pad }}">
      <div class="pad-btn" @click="padPrev"><text class="pad-text">▲ 上一页</text></div>
      <div class="pad-btn" @click="padNext"><text class="pad-text">▼ 下一页</text></div>
      <div class="pad-btn" @click="toggleHold"><text class="pad-text">2×</text></div>
    </div>

    <div class="footer">
      <text class="hint">上下滑翻页 · 左右滑横滑</text>
      <text class="hint">双击点赞 · 三击收藏</text>
      <text class="hint">按住 2 倍速</text>
      <text class="hint">下滑锁定 · 上滑取消</text>
      <text class="count">翻 {{ pageCount }} · 横 {{ swipeCount }} · ×2 {{ holdCount }} · {{ ver }}</text>
    </div>
  </div>
</template>

<script>
import interconnect from '@system.interconnect'
import vibrator from '@system.vibrator'
import router from '@system.router'
import platform from '../../common/platform'

const THRESHOLD = 26
// 横向位移要压过纵向的 1.2 倍才算左右滑，避免斜滑时抖动串味
const AXIS_RATIO = 1.2
const DEDUPE_MS = 350
// 按住超过这个时间（毫秒）就进入「2 倍速」长按模式
const LONG_PRESS_MS = 420
// 手指移动超过这个距离（dp）就取消长按，判定为滑动
const MOVE_TOLERANCE = 18
// 连击判定窗口：两下间隔小于这个时间才算双击/三击
const TAP_GAP_MS = 280
// 滑动在 touchmove 里就提前触发：手环的「右滑返回」是系统手势，
// 滑到一半就被系统接管，页面收不到后面的 touchmove / touchend，
// 等到松手再判会永远判不出来。横向阈值给小一点，抢在系统前面把指令发出去。
const H_FIRE = 14
const V_FIRE = 26
// 加速中下滑超过这个距离 = 锁定 2 倍速；锁定后上滑超过这个距离 = 取消锁定
const LOCK_THRESHOLD = 24
// 版本号：改版本时这里要跟着 manifest.json / package.json 一起改
const VERSION = 'v1.2.0'

let conn = null

export default {
  private: {
    linked: false,
    arrow: '↕',
    actionText: '滑动或长按',
    pageCount: 0,
    swipeCount: 0,
    holdCount: 0,
    allowExit: false,
    ver: VERSION,
    pad: platform.pad,
    devName: platform.name,
    startX: 0,
    startY: 0,
    lastFireAt: 0,
    holding: false,
    locked: false,
    gestureFired: false,
    touchAt: 0,
    rightDrag: false,
    pressTimer: null,
    tapCount: 0,
    tapTimer: null
  },

  onInit() {
    this.connect()
  },

  onShow() {
    this.refreshState()
  },

  // 系统右滑 / 返回键会退出页面，这里全部吃掉：退出只认右上角按钮
  onBackPress() {
    if (this.allowExit) {
      return false
    }
    // 手环的「右滑返回」是系统手势，滑动到一半就被系统接管，
    // 页面拿不到完整的 touchmove / touchend，所以「右滑」永远判不出来。
    // 这里把被系统吃掉的那次右滑当成一次「向右滑」指令补发出去。
    const fresh = this.touchAt > 0 && Date.now() - this.touchAt < 900
    if (fresh && this.rightDrag && !this.gestureFired && !this.holding && !this.locked) {
      this.gestureFired = true
      this.judge(-1, true)
    }
    return true
  },

  onHide() {
    this.cancelPressTimer()
    this.cancelTapTimer()
    this.endHold()
  },

  onDestroy() {
    this.cancelPressTimer()
    this.cancelTapTimer()
    this.endHold()
  },

  connect() {
    if (conn) {
      return
    }
    conn = interconnect.instance()
    conn.onopen = () => {
      this.linked = true
    }
    conn.onclose = () => {
      this.linked = false
      this.endHold()
    }
    conn.onerror = () => {
      this.linked = false
      this.endHold()
    }
  },

  refreshState() {
    this.connect()
    if (!conn) {
      return
    }
    try {
      conn.getReadyState({
        success: (res) => {
          this.linked = res.status === 1
        },
        fail: () => {
          this.linked = false
        }
      })
    } catch (err) {
      console.log('getReadyState error: ' + err)
    }
  },

  exit() {
    this.cancelPressTimer()
    this.cancelTapTimer()
    this.endHold()
    this.allowExit = true
    try {
      router.back()
    } catch (err) {
      console.log('exit error: ' + err)
    }
  },

  pickPoint(e, isEnd) {
    const list = isEnd ? (e.changedTouches || e.touches) : e.touches
    if (list && list.length > 0) {
      return { x: list[0].clientX || 0, y: list[0].clientY || 0 }
    }
    return { x: e.clientX || 0, y: e.clientY || 0 }
  },

  cancelPressTimer() {
    if (this.pressTimer) {
      clearTimeout(this.pressTimer)
      this.pressTimer = null
    }
  },

  cancelTapTimer() {
    if (this.tapTimer) {
      clearTimeout(this.tapTimer)
      this.tapTimer = null
    }
    this.tapCount = 0
  },

  onTouchStart(e) {
    const p = this.pickPoint(e, false)
    this.startX = p.x
    this.startY = p.y
    this.gestureFired = false
    this.rightDrag = false
    this.touchAt = Date.now()
    this.holding = false
    this.cancelPressTimer()
    // 锁定状态下这次按下只用来识别「上滑取消」，不再重新进长按
    if (this.locked) {
      return
    }
    // 按住不动到点就进入加速模式；中途滑动会被 onTouchMove 取消
    this.pressTimer = setTimeout(() => {
      this.pressTimer = null
      this.beginHold()
    }, LONG_PRESS_MS)
  },

  onTouchMove(e) {
    const p = this.pickPoint(e, false)
    const dx = p.x - this.startX
    // dy > 0 = 手指往上滑，dy < 0 = 往下滑
    const dy = this.startY - p.y
    const ax = Math.abs(dx)
    const ay = Math.abs(dy)

    // 已锁定 2 倍速：只认「上滑取消」，其它滑动一律忽略，免得误翻页
    if (this.locked) {
      if (dy > LOCK_THRESHOLD) {
        this.unlockHold()
      }
      return
    }

    // 正在加速（已按住 0.42 秒）：下滑锁定，其它滑动忽略
    if (this.holding) {
      if (dy < -LOCK_THRESHOLD) {
        this.lockHold()
      }
      return
    }

    if (ax > MOVE_TOLERANCE || ay > MOVE_TOLERANCE) {
      this.cancelPressTimer()
    }
    if (this.gestureFired) {
      return
    }

    // 只要往右拖过一点就记下来：万一位移还没到阈值就被系统手势接管，
    // 由 onBackPress 兜底补发一次「向右滑」
    if (dx >= 4 && ax >= ay) {
      this.rightDrag = true
    }

    // 不等松手：够距离就先发出去，右滑才有机会抢在系统返回手势前面
    if (ax > ay * 1.35 && ax >= H_FIRE) {
      this.gestureFired = true
      this.judge(dx < 0 ? 1 : -1, true)
      return
    }
    if (ay > ax * 1.35 && ay >= V_FIRE) {
      this.gestureFired = true
      this.judge(dy > 0 ? 1 : -1, false)
    }
  },

  onTouchCancel() {
    this.cancelPressTimer()
    this.touchAt = 0
    this.gestureFired = false
    if (this.holding) {
      this.endHold()
    }
  },

  beginHold() {
    if (this.holding || this.locked) {
      return
    }
    this.holding = true
    this.holdCount = this.holdCount + 1
    this.arrow = '2×'
    this.actionText = '加速中 · 下滑锁定'
    this.send({ t: 'press' })
    this.vibrate()
  },

  // 加速中下滑：锁定 2 倍速，松手也不恢复
  lockHold() {
    if (this.locked) {
      return
    }
    this.locked = true
    this.holding = false
    this.send({ t: 'lock', n: 1 })
    this.vibrate()
    this.arrow = '2×'
    this.actionText = '已锁定 · 上滑取消'
  },

  // 锁定后上滑：取消锁定，恢复 1 倍速
  unlockHold() {
    if (!this.locked) {
      return
    }
    this.locked = false
    this.holding = false
    // 取消锁定用的是这一次上滑，别让它再顺手翻一页
    this.gestureFired = true
    this.send({ t: 'lock', n: 0 })
    this.vibrate()
    this.arrow = '↕'
    this.actionText = '已恢复 1 倍速'
  },

  endHold() {
    if (this.locked) {
      this.unlockHold()
      return
    }
    if (!this.holding) {
      return
    }
    this.holding = false
    this.send({ t: 'release' })
    this.arrow = '↕'
    this.actionText = '已恢复 1 倍速'
  },

  onTouchEnd(e) {
    this.cancelPressTimer()
    this.touchAt = 0
    // 锁定中松手：保持加速，不发 release
    if (this.locked) {
      return
    }
    // 长按松手：只发「抬起」，不要再当成一次滑动
    if (this.holding) {
      this.endHold()
      return
    }
    // 滑动指令已经在 touchmove 里发出去了
    if (this.gestureFired) {
      return
    }

    const p = this.pickPoint(e, true)
    const dx = p.x - this.startX
    const dy = this.startY - p.y
    const ax = Math.abs(dx)
    const ay = Math.abs(dy)
    if (Math.max(ax, ay) < THRESHOLD) {
      // 没位移 = 点按：连点两下点赞，连点三下收藏
      this.registerTap()
      return
    }

    if (ax > ay * AXIS_RATIO) {
      // 左右滑 = 在手机上横向滑一下（手指往左 / 往右），不再是翻页
      this.judge(dx < 0 ? 1 : -1, true)
    } else {
      this.judge(dy > 0 ? 1 : -1, false)
    }
  },

  registerTap() {
    this.tapCount = this.tapCount + 1
    if (this.tapTimer) {
      clearTimeout(this.tapTimer)
      this.tapTimer = null
    }
    if (this.tapCount >= 3) {
      this.tapCount = 0
      this.fireTap(3)
      return
    }
    // 停手 280ms 再决定是单击还是双击；单击不发指令，避免误触
    this.tapTimer = setTimeout(() => {
      const n = this.tapCount
      this.tapCount = 0
      this.tapTimer = null
      if (n >= 2) {
        this.fireTap(2)
      }
    }, TAP_GAP_MS)
  },

  fireTap(n) {
    this.send({ t: 'tap', n: n })
    this.vibrate()
    if (n >= 3) {
      this.arrow = '★'
      this.actionText = '已收藏'
    } else {
      this.arrow = '♥'
      this.actionText = '已点赞'
    }
  },

  judge(dir, horizontal) {
    const now = Date.now()
    if (now - this.lastFireAt < DEDUPE_MS) {
      return
    }
    this.lastFireAt = now
    this.fire(dir, horizontal)
  },

  // ── 屏幕按钮（只在 platform.pad 的设备上出现，比如 Watch 6）────────────
  padPrev() {
    this.judge(-1, false)
  },

  padNext() {
    this.judge(1, false)
  },

  // 按钮模式下没法「按住不放」，改成点一下锁定加速、再点一下取消
  toggleHold() {
    if (this.locked) {
      this.unlockHold()
      return
    }
    if (this.holding) {
      this.lockHold()
      return
    }
    this.beginHold()
    this.lockHold()
  },

  send(payload) {
    if (!conn) {
      this.connect()
    }
    try {
      conn.send({
        data: payload,
        success: () => {
          this.linked = true
        },
        fail: () => {
          this.linked = false
        }
      })
    } catch (err) {
      console.log('send error: ' + err)
      this.linked = false
    }
  },

  vibrate() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (err) {
      console.log('vibrate not supported')
    }
  },

  fire(dir, horizontal) {
    // a: v = 竖向手势，h = 横向手势；d: 1 = 手指往左/往上，-1 = 往右/往下
    this.send({ t: 'page', d: dir, a: horizontal ? 'h' : 'v' })
    this.vibrate()

    if (horizontal) {
      this.swipeCount = this.swipeCount + 1
      this.arrow = dir > 0 ? '←' : '→'
      this.actionText = dir > 0 ? '向左滑' : '向右滑'
      return
    }

    this.pageCount = this.pageCount + 1
    this.arrow = dir > 0 ? '↑' : '↓'
    this.actionText = dir > 0 ? '下一页' : '上一页'
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 12px 8px;
}

.topbar {
  width: 100%;
  height: 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.status {
  flex-direction: row;
  align-items: center;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-right: 5px;
}

.status-text {
  font-size: 10px;
  color: #B4B2A9;
}

.exit {
  font-size: 11px;
  color: #F1EFE8;
  background-color: #3A3A38;
  border-radius: 9px;
  height: 18px;
  padding: 0 9px;
  text-align: center;
}

.stage {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.arrow {
  font-size: 64px;
  color: #5DCAA5;
}

.action {
  font-size: 13px;
  color: #F1EFE8;
  margin-top: 4px;
}

.pad {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.pad-btn {
  height: 26px;
  padding-left: 10px;
  padding-right: 10px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 13px;
  background-color: #3A3A38;
  align-items: center;
  justify-content: center;
}

.pad-text {
  font-size: 12px;
  color: #F1EFE8;
}

.footer {
  flex-direction: column;
  align-items: center;
}
.hint {
  font-size: 10px;
  color: #888780;
  margin-top: 2px;
}

.count {
  font-size: 9px;
  color: #5F5E5A;
  margin-top: 8px;
}
</style>
