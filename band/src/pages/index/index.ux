<template>
  <div class="page" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd">
    <div class="topbar">
      <div class="status">
        <div class="dot" style="background-color: {{ linked ? '#1D9E75' : '#A32D2D' }}"></div>
        <text class="status-text">{{ linked ? '已连接' : '未连接' }}</text>
      </div>
      <text class="exit" @click="exit">退出</text>
    </div>

    <div class="stage">
      <text class="arrow">{{ arrow }}</text>
      <text class="action">{{ actionText }}</text>
    </div>

    <div class="footer">
      <text class="hint">上滑 / 左滑 → 下一页</text>
      <text class="hint">下滑 / 右滑 → 上一页</text>
      <text class="hint">按住不动 → 2 倍速</text>
      <text class="count">下 {{ upCount }} · 上 {{ downCount }} · ×2 {{ holdCount }} · {{ ver }}</text>
    </div>
  </div>
</template>

<script>
import interconnect from '@system.interconnect'
import vibrator from '@system.vibrator'
import router from '@system.router'

const THRESHOLD = 28
// 横向位移要压过纵向的 1.2 倍才算左右滑，避免斜滑时抖动串味
const AXIS_RATIO = 1.2
const DEDUPE_MS = 350
// 按住超过这个时间（毫秒）就进入「2 倍速」长按模式
const LONG_PRESS_MS = 420
// 手指移动超过这个距离（dp）就取消长按，判定为滑动
const MOVE_TOLERANCE = 18
// 版本号：改版本时这里要跟着 manifest.json / package.json 一起改
const VERSION = 'v1.1.5'

let conn = null

export default {
  private: {
    linked: false,
    arrow: '↕',
    actionText: '滑动或长按',
    upCount: 0,
    downCount: 0,
    holdCount: 0,
    ver: VERSION,
    startX: 0,
    startY: 0,
    lastFireAt: 0,
    holding: false,
    pressTimer: null
  },

  onInit() {
    this.connect()
  },

  onShow() {
    this.refreshState()
  },

  onHide() {
    this.cancelPressTimer()
    this.endHold()
  },

  onDestroy() {
    this.cancelPressTimer()
    this.endHold()
  },

  connect() {
    if (conn) {
      return
    }
    conn = interconnect.instance()
    conn.onopen = () => {
      this.linked = true
    }
    conn.onclose = () => {
      this.linked = false
      this.endHold()
    }
    conn.onerror = () => {
      this.linked = false
      this.endHold()
    }
  },

  refreshState() {
    this.connect()
    if (!conn) {
      return
    }
    try {
      conn.getReadyState({
        success: (res) => {
          this.linked = res.status === 1
        },
        fail: () => {
          this.linked = false
        }
      })
    } catch (err) {
      console.log('getReadyState error: ' + err)
    }
  },

  exit() {
    this.cancelPressTimer()
    this.endHold()
    try {
      router.back()
    } catch (err) {
      console.log('exit error: ' + err)
    }
  },

  pickPoint(e, isEnd) {
    const list = isEnd ? (e.changedTouches || e.touches) : e.touches
    if (list && list.length > 0) {
      return { x: list[0].clientX || 0, y: list[0].clientY || 0 }
    }
    return { x: e.clientX || 0, y: e.clientY || 0 }
  },

  cancelPressTimer() {
    if (this.pressTimer) {
      clearTimeout(this.pressTimer)
      this.pressTimer = null
    }
  },

  onTouchStart(e) {
    const p = this.pickPoint(e, false)
    this.startX = p.x
    this.startY = p.y
    this.holding = false
    this.cancelPressTimer()
    // 按住不动到点就进入加速模式；中途滑动会被 onTouchMove 取消
    this.pressTimer = setTimeout(() => {
      this.pressTimer = null
      this.beginHold()
    }, LONG_PRESS_MS)
  },

  onTouchMove(e) {
    if (this.holding) {
      return
    }
    const p = this.pickPoint(e, false)
    if (Math.abs(p.x - this.startX) > MOVE_TOLERANCE
      || Math.abs(p.y - this.startY) > MOVE_TOLERANCE) {
      this.cancelPressTimer()
    }
  },

  beginHold() {
    if (this.holding) {
      return
    }
    this.holding = true
    this.holdCount = this.holdCount + 1
    this.arrow = '2×'
    this.actionText = '加速中，松手恢复'
    this.send({ t: 'press' })
    this.vibrate()
  },

  endHold() {
    if (!this.holding) {
      return
    }
    this.holding = false
    this.send({ t: 'release' })
    this.arrow = '↕'
    this.actionText = '已恢复 1 倍速'
  },

  onTouchEnd(e) {
    this.cancelPressTimer()
    // 长按松手：只发「抬起」，不要再当成一次滑动
    if (this.holding) {
      this.endHold()
      return
    }

    const p = this.pickPoint(e, true)
    const dx = p.x - this.startX
    const dy = this.startY - p.y
    const ax = Math.abs(dx)
    const ay = Math.abs(dy)
    if (Math.max(ax, ay) < THRESHOLD) {
      return
    }

    if (ax > ay * AXIS_RATIO) {
      // 左滑 → 下一页，右滑 → 上一页
      this.judge(dx < 0 ? 1 : -1)
    } else {
      this.judge(dy > 0 ? 1 : -1)
    }
  },

  judge(dir) {
    const now = Date.now()
    if (now - this.lastFireAt < DEDUPE_MS) {
      return
    }
    this.lastFireAt = now
    this.fire(dir)
  },

  send(payload) {
    if (!conn) {
      this.connect()
    }
    try {
      conn.send({
        data: payload,
        success: () => {
          this.linked = true
        },
        fail: () => {
          this.linked = false
        }
      })
    } catch (err) {
      console.log('send error: ' + err)
      this.linked = false
    }
  },

  vibrate() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (err) {
      console.log('vibrate not supported')
    }
  },

  fire(dir) {
    this.send({ t: 'page', d: dir })
    this.vibrate()

    if (dir > 0) {
      this.upCount = this.upCount + 1
      this.arrow = '↑'
      this.actionText = '下一页'
    } else {
      this.downCount = this.downCount + 1
      this.arrow = '↓'
      this.actionText = '上一页'
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 12px 8px;
}

.topbar {
  width: 100%;
  height: 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.status {
  flex-direction: row;
  align-items: center;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-right: 5px;
}

.status-text {
  font-size: 10px;
  color: #B4B2A9;
}

.exit {
  font-size: 11px;
  color: #F1EFE8;
  background-color: #3A3A38;
  border-radius: 9px;
  height: 18px;
  padding: 0 9px;
  text-align: center;
}

.stage {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.arrow {
  font-size: 64px;
  color: #5DCAA5;
}

.action {
  font-size: 13px;
  color: #F1EFE8;
  margin-top: 4px;
}

.footer {
  flex-direction: column;
  align-items: center;
}

.hint {
  font-size: 10px;
  color: #888780;
  margin-top: 2px;
}

.count {
  font-size: 9px;
  color: #5F5E5A;
  margin-top: 8px;
}
</style>
