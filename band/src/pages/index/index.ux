<template>
  <div class="page" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd">
    <div class="topbar">
      <div class="status">
        <div class="dot" style="background-color: {{ linked ? '#1D9E75' : '#A32D2D' }}"></div>
        <text class="status-text">{{ linked ? '已连接' : '未连接' }}</text>
      </div>
      <text class="exit" @click="exit">退出</text>
    </div>

    <div class="stage">
      <text class="arrow">{{ arrow }}</text>
      <text class="action">{{ actionText }}</text>
    </div>

    <div class="footer">
      <text class="hint">上滑 / 下滑 → 上下翻页</text>
      <text class="hint">左滑 / 右滑 → 横滑一下</text>
      <text class="hint">双击点赞 · 三击收藏</text>
      <text class="hint">按住不动 → 2 倍速</text>
      <text class="count">翻 {{ pageCount }} · 横 {{ swipeCount }} · ×2 {{ holdCount }} · {{ ver }}</text>
    </div>
  </div>
</template>

<script>
import interconnect from '@system.interconnect'
import vibrator from '@system.vibrator'
import router from '@system.router'

const THRESHOLD = 28
// 横向位移要压过纵向的 1.2 倍才算左右滑，避免斜滑时抖动串味
const AXIS_RATIO = 1.2
const DEDUPE_MS = 350
// 按住超过这个时间（毫秒）就进入「2 倍速」长按模式
const LONG_PRESS_MS = 420
// 手指移动超过这个距离（dp）就取消长按，判定为滑动
const MOVE_TOLERANCE = 18
// 连击判定窗口：两下间隔小于这个时间才算双击/三击
const TAP_GAP_MS = 280
// 版本号：改版本时这里要跟着 manifest.json / package.json 一起改
const VERSION = 'v1.1.7'

let conn = null

export default {
  private: {
    linked: false,
    arrow: '↕',
    actionText: '滑动或长按',
    pageCount: 0,
    swipeCount: 0,
    holdCount: 0,
    allowExit: false,
    ver: VERSION,
    startX: 0,
    startY: 0,
    lastFireAt: 0,
    holding: false,
    pressTimer: null,
    tapCount: 0,
    tapTimer: null
  },

  onInit() {
    this.connect()
  },

  onShow() {
    this.refreshState()
  },

  // 系统右滑 / 返回键会退出页面，这里全部吃掉：退出只认右上角按钮
  onBackPress() {
    if (this.allowExit) {
      return false
    }
    return true
  },

  onHide() {
    this.cancelPressTimer()
    this.cancelTapTimer()
    this.endHold()
  },

  onDestroy() {
    this.cancelPressTimer()
    this.cancelTapTimer()
    this.endHold()
  },

  connect() {
    if (conn) {
      return
    }
    conn = interconnect.instance()
    conn.onopen = () => {
      this.linked = true
    }
    conn.onclose = () => {
      this.linked = false
      this.endHold()
    }
    conn.onerror = () => {
      this.linked = false
      this.endHold()
    }
  },

  refreshState() {
    this.connect()
    if (!conn) {
      return
    }
    try {
      conn.getReadyState({
        success: (res) => {
          this.linked = res.status === 1
        },
        fail: () => {
          this.linked = false
        }
      })
    } catch (err) {
      console.log('getReadyState error: ' + err)
    }
  },

  exit() {
    this.cancelPressTimer()
    this.cancelTapTimer()
    this.endHold()
    this.allowExit = true
    try {
      router.back()
    } catch (err) {
      console.log('exit error: ' + err)
    }
  },

  pickPoint(e, isEnd) {
    const list = isEnd ? (e.changedTouches || e.touches) : e.touches
    if (list && list.length > 0) {
      return { x: list[0].clientX || 0, y: list[0].clientY || 0 }
    }
    return { x: e.clientX || 0, y: e.clientY || 0 }
  },

  cancelPressTimer() {
    if (this.pressTimer) {
      clearTimeout(this.pressTimer)
      this.pressTimer = null
    }
  },

  cancelTapTimer() {
    if (this.tapTimer) {
      clearTimeout(this.tapTimer)
      this.tapTimer = null
    }
    this.tapCount = 0
  },

  onTouchStart(e) {
    const p = this.pickPoint(e, false)
    this.startX = p.x
    this.startY = p.y
    this.holding = false
    this.cancelPressTimer()
    // 按住不动到点就进入加速模式；中途滑动会被 onTouchMove 取消
    this.pressTimer = setTimeout(() => {
      this.pressTimer = null
      this.beginHold()
    }, LONG_PRESS_MS)
  },

  onTouchMove(e) {
    if (this.holding) {
      return
    }
    const p = this.pickPoint(e, false)
    if (Math.abs(p.x - this.startX) > MOVE_TOLERANCE
      || Math.abs(p.y - this.startY) > MOVE_TOLERANCE) {
      this.cancelPressTimer()
    }
  },

  beginHold() {
    if (this.holding) {
      return
    }
    this.holding = true
    this.holdCount = this.holdCount + 1
    this.arrow = '2×'
    this.actionText = '加速中，松手恢复'
    this.send({ t: 'press' })
    this.vibrate()
  },

  endHold() {
    if (!this.holding) {
      return
    }
    this.holding = false
    this.send({ t: 'release' })
    this.arrow = '↕'
    this.actionText = '已恢复 1 倍速'
  },

  onTouchEnd(e) {
    this.cancelPressTimer()
    // 长按松手：只发「抬起」，不要再当成一次滑动
    if (this.holding) {
      this.endHold()
      return
    }

    const p = this.pickPoint(e, true)
    const dx = p.x - this.startX
    const dy = this.startY - p.y
    const ax = Math.abs(dx)
    const ay = Math.abs(dy)
    if (Math.max(ax, ay) < THRESHOLD) {
      // 没位移 = 点按：连点两下点赞，连点三下收藏
      this.registerTap()
      return
    }

    if (ax > ay * AXIS_RATIO) {
      // 左右滑 = 在手机上横向滑一下（手指往左 / 往右），不再是翻页
      this.judge(dx < 0 ? 1 : -1, true)
    } else {
      this.judge(dy > 0 ? 1 : -1, false)
    }
  },

  registerTap() {
    this.tapCount = this.tapCount + 1
    if (this.tapTimer) {
      clearTimeout(this.tapTimer)
      this.tapTimer = null
    }
    if (this.tapCount >= 3) {
      this.tapCount = 0
      this.fireTap(3)
      return
    }
    // 停手 280ms 再决定是单击还是双击；单击不发指令，避免误触
    this.tapTimer = setTimeout(() => {
      const n = this.tapCount
      this.tapCount = 0
      this.tapTimer = null
      if (n >= 2) {
        this.fireTap(2)
      }
    }, TAP_GAP_MS)
  },

  fireTap(n) {
    this.send({ t: 'tap', n: n })
    this.vibrate()
    if (n >= 3) {
      this.arrow = '★'
      this.actionText = '已收藏'
    } else {
      this.arrow = '♥'
      this.actionText = '已点赞'
    }
  },

  judge(dir, horizontal) {
    const now = Date.now()
    if (now - this.lastFireAt < DEDUPE_MS) {
      return
    }
    this.lastFireAt = now
    this.fire(dir, horizontal)
  },

  send(payload) {
    if (!conn) {
      this.connect()
    }
    try {
      conn.send({
        data: payload,
        success: () => {
          this.linked = true
        },
        fail: () => {
          this.linked = false
        }
      })
    } catch (err) {
      console.log('send error: ' + err)
      this.linked = false
    }
  },

  vibrate() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (err) {
      console.log('vibrate not supported')
    }
  },

  fire(dir, horizontal) {
    // a: v = 竖向手势，h = 横向手势；d: 1 = 手指往左/往上，-1 = 往右/往下
    this.send({ t: 'page', d: dir, a: horizontal ? 'h' : 'v' })
    this.vibrate()

    if (horizontal) {
      this.swipeCount = this.swipeCount + 1
      this.arrow = dir > 0 ? '←' : '→'
      this.actionText = dir > 0 ? '向左滑' : '向右滑'
      return
    }

    this.pageCount = this.pageCount + 1
    this.arrow = dir > 0 ? '↑' : '↓'
    this.actionText = dir > 0 ? '下一页' : '上一页'
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 12px 8px;
}

.topbar {
  width: 100%;
  height: 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.status {
  flex-direction: row;
  align-items: center;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-right: 5px;
}

.status-text {
  font-size: 10px;
  color: #B4B2A9;
}

.exit {
  font-size: 11px;
  color: #F1EFE8;
  background-color: #3A3A38;
  border-radius: 9px;
  height: 18px;
  padding: 0 9px;
  text-align: center;
}

.stage {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.arrow {
  font-size: 64px;
  color: #5DCAA5;
}

.action {
  font-size: 13px;
  color: #F1EFE8;
  margin-top: 4px;
}

.footer {
  flex-direction: column;
  align-items: center;
}

.hint {
  font-size: 10px;
  color: #888780;
  margin-top: 2px;
}

.count {
  font-size: 9px;
  color: #5F5E5A;
  margin-top: 8px;
}
</style>
